---
import Default from "@astrojs/starlight/components/Footer.astro";
import { localeOf } from "../lib/anatomy-text";
import { copyright } from "../lib/footer";

const locale = localeOf(Astro.currentLocale);
---

<Default />
<p class="nx-copyright">{copyright(locale)}</p>

<style>
  .nx-copyright {
    margin: 2rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
