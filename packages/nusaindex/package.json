{
  "name": "nusaindex",
  "version": "0.0.0",
  "description": "Validate, parse, and format Indonesian data, with reference data that stays current.",
  "license": "MIT",
  "author": "Haikal Mumtaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haikalmumtaz233/nusaindex.git",
    "directory": "packages/nusaindex"
  },
  "keywords": [
    "indonesia",
    "nik",
    "npwp",
    "nitku",
    "phone",
    "validation"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nik": {
      "types": "./dist/nik.d.ts",
      "default": "./dist/nik.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    },
    "./npwp": {
      "types": "./dist/npwp.d.ts",
      "default": "./dist/npwp.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "size": "size-limit",
    "pkg:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "size-limit": [
    {
      "name": "nusaindex (all)",
      "path": "dist/index.js",
      "limit": "20 kB",
      "gzip": true
    },
    {
      "name": "nik",
      "path": "dist/nik.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "normalize",
      "path": "dist/normalize.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "npwp",
      "path": "dist/npwp.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "phone",
      "path": "dist/phone.js",
      "limit": "2 kB",
      "gzip": true
    }
  ]
}
