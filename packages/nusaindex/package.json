{
  "name": "nusaindex",
  "version": "0.2.0",
  "description": "Validate, parse, and format Indonesian data, with reference data that stays current.",
  "license": "MIT",
  "author": "Haikal Mumtaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haikalmumtaz233/nusaindex.git",
    "directory": "packages/nusaindex"
  },
  "keywords": [
    "indonesia",
    "nik",
    "npwp",
    "nitku",
    "phone",
    "region",
    "validation"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bank": {
      "types": "./dist/bank.d.ts",
      "default": "./dist/bank.js"
    },
    "./holiday": {
      "types": "./dist/holiday.d.ts",
      "default": "./dist/holiday.js"
    },
    "./nik": {
      "types": "./dist/nik.d.ts",
      "default": "./dist/nik.js"
    },
    "./nip": {
      "types": "./dist/nip.d.ts",
      "default": "./dist/nip.js"
    },
    "./nisn": {
      "types": "./dist/nisn.d.ts",
      "default": "./dist/nisn.js"
    },
    "./normalize": {
      "types": "./dist/normalize.d.ts",
      "default": "./dist/normalize.js"
    },
    "./npwp": {
      "types": "./dist/npwp.d.ts",
      "default": "./dist/npwp.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./plate": {
      "types": "./dist/plate.d.ts",
      "default": "./dist/plate.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "default": "./dist/region.js"
    },
    "./rupiah": {
      "types": "./dist/rupiah.d.ts",
      "default": "./dist/rupiah.js"
    },
    "./workday": {
      "types": "./dist/workday.d.ts",
      "default": "./dist/workday.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "size": "size-limit",
    "pkg:check": "publint --strict && attw --pack . --profile esm-only"
  },
  "size-limit": [
    {
      "name": "nusaindex (all, region shards load on demand)",
      "path": "dist/index.js",
      "entry": [
        "index"
      ],
      "limit": "26 kB",
      "gzip": true
    },
    {
      "name": "nik",
      "path": "dist/nik.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "nip",
      "path": "dist/nip.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "nisn",
      "path": "dist/nisn.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "normalize",
      "path": "dist/normalize.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "npwp",
      "path": "dist/npwp.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "phone",
      "path": "dist/phone.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "plate",
      "path": "dist/plate.js",
      "limit": "2 kB",
      "gzip": true
    },
    {
      "name": "region (index, shards load on demand)",
      "path": "dist/region.js",
      "entry": [
        "region"
      ],
      "limit": "16 kB",
      "gzip": true
    },
    {
      "name": "holiday",
      "path": "dist/holiday.js",
      "limit": "6 kB",
      "gzip": true
    },
    {
      "name": "workday",
      "path": "dist/workday.js",
      "limit": "7 kB",
      "gzip": true
    },
    {
      "name": "bank",
      "path": "dist/bank.js",
      "limit": "5 kB",
      "gzip": true
    },
    {
      "name": "rupiah",
      "path": "dist/rupiah.js",
      "limit": "2 kB",
      "gzip": true
    }
  ]
}
